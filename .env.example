# Application Environment
ENVIRONMENT=development
APP_NAME=OncoAI Chemistry & Bioactivity Data Platform
API_V1_STR=/v1

# Security & Multi-Tenancy
API_KEY=oncoai-dev-secret-key-change-in-prod
DEFAULT_TENANT_ID=default-tenant

# Relational Serving Database
# For local dev without Docker: sqlite+aiosqlite:///./data/oncoai.db
# For PostgreSQL: postgresql+asyncpg://oncoai_user:oncoai_pass@localhost:5432/oncoai
DATABASE_URL=sqlite+aiosqlite:///./data/oncoai.db

# Storage Layer (Cold & Warm)
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./data/storage
S3_ENDPOINT_URL=
S3_BUCKET_NAME=oncoai-raw-lake
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Columnar Parquet Data Lake (Warm Tier)
PARQUET_LAKE_PATH=./data/storage/parquet

# Scientific Processing Versioning
PIPELINE_VERSION=chem-std-1.0.0
FINGERPRINT_VERSION=morgan-r2-2048-v1
EXPECTED_RDKIT_VERSION=2024.3.5

# Worker & Background Tasks
WORKER_CONCURRENCY=2
